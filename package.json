{
  "name": "billing-system",
  "version": "1.0.7",
  "description": "Offline Windows POS Billing Software (Electron + React + SQLite + Prisma)",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm --prefix renderer run dev\" \"wait-on -t 120000 http-get://127.0.0.1:5173 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "build:renderer": "npm --prefix renderer run build",
    "build": "npm run build:renderer",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:template": "node scripts/create-db-template.js",
    "branding:prepare": "node scripts/prepare-branding.js",
    "clean:release": "node scripts/clean-release.js",
    "dist": "npm run clean:release && npm run prisma:generate && npm run build && npm run db:template && npm run branding:prepare && electron-builder --win --x64",
    "dist:portable": "npm run clean:release && npm run prisma:generate && npm run build && npm run db:template && npm run branding:prepare && electron-builder --win portable --x64"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^2.1.8",
    "prisma": "^6.19.3",
    "sharp": "^0.34.5",
    "wait-on": "^8.0.5"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "pdfkit": "^0.18.0"
  },
  "build": {
    "appId": "com.pos.billing",
    "productName": "POS Billing",
    "asar": true,
    "asarUnpack": [
      "generated/**/*",
      "**/*.node"
    ],
    "files": [
      "electron/**/*.js",
      "electron/splash.html",
      "logo/**/*",
      "renderer/dist/**",
      "prisma/schema.prisma",
      "generated/**/*",
      "package.json",
      "node_modules/**/*",
      "!**/*.db",
      "!**/*.db-journal",
      "!renderer/src/**",
      "!node_modules/prisma/**",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/@prisma/engines/**",
      "!node_modules/@prisma/migrate/**",
      "!node_modules/@prisma/fetch-engine/**",
      "!**/test/**",
      "!**/tests/**",
      "!**/*.md"
    ],
    "extraResources": [
      {
        "from": "build/pos-template.db",
        "to": "pos-template.db"
      },
      {
        "from": "logo/default",
        "to": "logo/default"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "directories": {
      "output": "release"
    }
  }
}
